# Copie para .env.local e preencha os valores reais. NUNCA commite .env.local
# (ja esta no .gitignore) nem cole valores reais neste arquivo.

# --- Supabase ---
# URL e anon key do projeto Supabase. Sao publicas por design (expostas ao
# browser via NEXT_PUBLIC_*) -- quem protege os dados e o RLS no Postgres,
# nao o sigilo destas duas variaveis.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key do Supabase. NUNCA prefixar com NEXT_PUBLIC_ -- ignora RLS
# por completo e so pode ser lida em codigo server-side ('use server',
# route handlers, cron). Ver uso em src/lib/supabase.ts (createAdminSupabaseClient).
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# URL publica de producao deste deploy (usada em src/proxy.ts para a
# allowlist de CORS).
NEXT_PUBLIC_SITE_URL=

# --- E-mail transacional (Gmail SMTP via Nodemailer) ---
# Ver src/lib/email.ts. GMAIL_SMTP_APP_PASSWORD e uma "App Password" do
# Google (nao a senha da conta).
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# --- Cron ---
# Token Bearer exigido por /api/cron/appointment-reminders. Gere um valor
# aleatorio longo (ex.: openssl rand -hex 32) e configure o mesmo valor no
# servico externo que dispara o cron.
CRON_SECRET=
